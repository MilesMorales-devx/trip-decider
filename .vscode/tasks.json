{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Trip Decider: Backend",
      "type": "process",
      "command": "python3",
      "args": [
        "backend/scripts/vscode_runner.py",
        "backend"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TRIP_DECIDER_BACKEND_PORT": "8001"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "trip-decider-backend",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Trip Decider: Frontend",
      "type": "shell",
      "command": "npm install && npm run dev -- --host 127.0.0.1 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "VITE_API_URL": "http://127.0.0.1:8001"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "trip-decider-frontend",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Trip Decider: Run App",
      "dependsOn": [
        "Trip Decider: Backend",
        "Trip Decider: Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Trip Decider: Train Model",
      "type": "process",
      "command": "python3",
      "args": [
        "backend/scripts/vscode_runner.py",
        "train"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Trip Decider: Backend Tests",
      "type": "process",
      "command": "python3",
      "args": [
        "backend/scripts/vscode_runner.py",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
